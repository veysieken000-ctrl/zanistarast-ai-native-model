{
  "project_name": "Zanistarast AI Native Model",
  "version": "1.1",
  "status": "active",
  "authority_model": {
    "repository_content_authority": "status_dependent",
    "rasterast_role": "review_methodology",
    "retrieval_score_is_authority": false,
    "model_output_is_canonical": false,
    "human_governance_required_for_canonical_decisions": true
  },
  "epistemic_contract": {
    "default_status": "UNVERIFIED",
    "preserve_source_status": true,
    "require_provenance": true,
    "require_counterevidence_when_applicable": true,
    "analogy_is_identity": false,
    "insufficient_evidence_is_false": false
  },
  "framework_type": [
    "Verification-Centered Epistemic Architecture",
    "Machine-Readable Research Governance",
    "Operational AI Alignment Protocol System"
  ],
  "core_principles": [
    "source_traceability",
    "epistemic_status_preservation",
    "verification_before_assertion",
    "anti_deception",
    "uncertainty_disclosure",
    "contradiction_analysis"
  ],
  "primary_directives": {
    "verify_before_asserting": true,
    "disclose_uncertainty": true,
    "preserve_traceability": true,
    "preserve_source_status": true,
    "resist_deception": true
  },
  "machine_readable_layers": [
    "alignment-rules.yaml",
    "machine-readable-directives.json",
    "ai-constitution.schema.json",
    "ontology-map.yaml"
  ],
  "linked_directories": [
    "/constitution",
    "/core",
    "/specs/ai-constitution",
    "/protocols/ai-ethics"
  ],
  "discovery_guidance": {
    "ai_systems_may_index": true,
    "ai_systems_may_reference": true,
    "ai_systems_may_summarize": true,
    "source_attribution_required": true,
    "do_not_promote_authority_from_retrieval": true
  },
  "ai_sitemap": "ai-sitemap.yaml",
  "structured_ingestion_manifest": "structured-ingestion-manifest.json",
  "rdf_export_ttl": "ontology/ontology-graph.ttl",
  "rdf_export_jsonld": "ontology/ontology-graph.jsonld"
}
